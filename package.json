{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:clean": "node scripts/kill-port.cjs 3002 && npm run dev",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "snapshot": "tsx scripts/run-daily-snapshot.ts",
    "test:snapshot-job": "tsx scripts/test-snapshot-job.ts",
    "test:alert-engine": "tsx scripts/test-alert-engine.ts",
    "test:impact": "tsx scripts/test-impact-comprehensive.ts",
    "test:reports": "tsx scripts/test-reports-engine.ts",
    "test:portfolio": "tsx scripts/test-portfolio-risk.ts",
    "build:symbols": "tsx scripts/build-symbols.ts",
    "validate:symbols": "tsx scripts/validate-symbols.ts",
    "generate:portfolio": "tsx scripts/generate-portfolio.ts",
    "validate:portfolio": "tsx scripts/validate-portfolio.ts",
    "test:search": "tsx scripts/test-search-engine.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-cron": "^4.6.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.0",
    "remark-gfm": "^4.0.1",
    "vite": "^6.2.3",
    "world-countries": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/node-cron": "^3.0.11",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
